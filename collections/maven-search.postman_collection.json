          "name": "Search Maven Central",
          "request": {
            "name": "Search Maven Central",
            "description": {
              "content": "Execute a Solr query against Maven Central. Use the `q` parameter with Solr field syntax to filter by groupId (`g:`), artifactId (`a:`), version (`v:`), classname (`c:`), fully-qualified classname (`fc:`), SHA-1 checksum (`1:`), or tags (`tags:`).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "select"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) Solr query string."
                },
                {
                  "disabled": false,
                  "key": "rows",
                  "value": "20",
                  "description": "Maximum number of results to return."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "0",
                  "description": "Result offset for pagination."
                },
                {
                  "disabled": false,
                  "key": "wt",
                  "value": "json",
                  "description": "Response format."
                },
                {
                  "disabled": false,
                  "key": "core",
                  "value": "<string>",
                  "description": "Specific Solr core to search (for example, `gav` to list versions)."
                }
              ],
              "variable": []
            },
